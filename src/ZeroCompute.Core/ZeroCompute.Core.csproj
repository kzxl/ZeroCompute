<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZeroCompute.Core</AssemblyName>
    <RootNamespace>ZeroCompute.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\..\ZeroTensor\src\ZeroTensor.Core\ZeroTensor.Core.csproj')">
    <ProjectReference Include="..\..\..\ZeroTensor\src\ZeroTensor.Core\ZeroTensor.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\ZeroTensor\src\ZeroTensor.Core\ZeroTensor.Core.csproj')">
    <PackageReference Include="ZeroTensor.Core" Version="1.0.0" />
  </ItemGroup>
</Project>
